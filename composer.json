{
    "name": "aksoyih/http-mock",
    "description": "A PHP library for mocking HTTP clients with customizable responses and behaviors",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Aksoyih\\HttpMock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aksoyih\\HttpMock\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Haluk Aksoy",
            "email": "me@halukaksoy.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "nyholm/psr7": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.0",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/http-client": "^7.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required for GuzzleHandler adapter",
        "symfony/http-client": "Required for SymfonyClient adapter"
    },
    "config": {
        "sort-packages": true
    }
}
